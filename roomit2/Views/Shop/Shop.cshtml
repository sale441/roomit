                            <div class="card-body Fliestext">
                                <h5 class="card-title fw-bold">Metall-Container-Box</h5>
                                <p class="card-text text Fliestext">
                                   Maße  (L x B x H): 240 x 150 x 225 cm <br>
                                   Max. Gewicht: 0,8 Tonnen <br>
                                   Geeignet für: Wohnungsinventar (30 m<sup>2</sup>)<br>

                                </p>
                                <p class="card-text"><strong class="text-muted">@*Anlieferung und Abholung ab 0,00 €*@</strong></p>

                                <div class="btn-roomit-div mt-4">
                                    <a type="button" asp-controller="Shop" asp-action="Container" asp-route-Zipcode="@Model?.Postleitzahl" asp-route-Stadtname="@Model?.Stadtname" class="btn btn-roomit abs btn-details">Details</a>
                                </div>
                            </div>
                        </div>
                        <!--  Quantity && + und -   -->
                        <div class="col-md-3 quantity">
                            <div class="quantity-1">
                                <span class="article-column-headline fw-bold">Anzahl</span>
                                <br />
                            </div>                                                    
                            <div class="cont-add-prod btn-roomit-div">                          
                                <button class="minus minus2 btn-roomit btn-center abs btn-shop" value="99" style="display:none;">-</button>
                                <p class="product-counter">0</p>
                                <button class="plus plus2 btn-roomit btn-center abs btn-shop" value="99">+</button>
                            </div>
                            @*<input type="button" class="btn btn-outline-success mt-4 in-warenkorb" style="min-width:60%;height: 42px;" value="IN DEN WARENKORB" />*@
                        </div>
                        <!-- Preis  -->
                        <div class="col-md-3 ps-5 Fliestext preis">
                            <div class="preis-1">
                                <span class="article-column-headline">Preis</span>
                                <br />
                                <span class="text">Pro Monat zzgl. Lieferkosten</span>
                            </div>

                            <div class="preis-1"> 
                                <div class="cont-add-prod text-center preis-2">                      
                                <span class="result fw-bold">0,00 €</span>                             
                            </div>                     
                             <div class="preis-3">
                                <input type="button" class="btn mt-4 in-warenkorb btn-roomit btn-center abs" style="min-width:auto;font-weight:normal!important"  value="In den Warenkorb" />
                            </div>
                            </div>
                           
                            
                            
                        </div>
                    </div>
                    <span class="price-info">ab <span class="price"> 99,00 €</span> pro Container-Box</span>
                </div>  
                }

                <div id="Einzelstücke" class="card cardItem C1 Fliestext">
                    <div class="row g-0 ga-x">
                        <!-- Bild -->
                        <div class="col-md-2 bild">
