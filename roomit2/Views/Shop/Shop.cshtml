                                </div>
                             <div class="preis-3">
                                <input type="button" class="btn mt-4 in-warenkorb btn-roomit btn-center abs" style="min-width:auto;font-weight:normal!important;"  value="In den Warenkorb" />
                            </div>
                        </div>
                         
                            
                            
                        </div>
                    </div>
                    <span class="price-info">ab <span class="price"> 99,00 €</span> pro Container-Box</span>
                </div>
                }
                else
                {
                    <div id="Container-Box-Metall" class="card cardItem C1">
