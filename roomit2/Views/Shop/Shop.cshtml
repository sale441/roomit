@model Warenkorb

@{
    ViewData["Title"] = "Lagerboxen online bestellen | room it!";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var tt = Model.WarenkorbItemsListe.Count();
}

@section metatags{
    <title>Vorteile der Einlagerung | room it!</title>
    <meta name="description" content="Alles rund um die Einlagerung: Der Service mit Container-Boxen✅ Karton-Boxen✅ Einzelstücken✅ » Jetzt Anfrage senden!">
    <meta name="keywords" content="Onlineshop, Shop, Einlagerung, Lagerboxen bestellen, Container-Box, Karton-Box, Einzelstücke, externes Lager, Auslagerung, Lagerbox, Container mieten, Storage">
}



<style>

    .btn-shop{
        min-width:66px;
        display:flex;
        justify-content:center;
        border-radius:5px;
    
    }

</style>

<div class="container shop Fliestext" style="max-width:1600px; margin-top:5%;">
    <div class="row">
        @if (ViewBag.Area != null)
        {
            <div style="text-align:center;margin-bottom:10%;position:relative;">
                <h1 class="zipcodeResult fw-bold mb-0" style="font-size:46px;">
                    <span>@ViewBag.Zipcode</span>
                    <span>@ViewBag.Area</span>
                 </h1>
                <div class="mb-4 lineX text" style="width:325px;"></div>
                <h3 class="text">Unsere aktuellen Angebote in deiner Region:</h3>
            </div>

            <div class="cardGroup ma-1">

                <div id="Karton-Box" class="card cardItem">
                    <div class="row g-0 ga-x">
                        <!-- Bild -->
                        <div class="col-md-2 bild">
                            <img src="/assets/images/Produkte_Karton3.png"  class="img-fluid rounded-start" alt="Produkte_Kartonbox" style="width:auto;height:215px;">
                        </div>
                        <!-- Text Infos -->
                        <div class="col-md-4 text-start float-end TextInfos">
                            <div class="card-body">
                                <h3 class="card-title fw-bold">Karton-Box</h3>
                                <p class="card-text text Fliestext">
                                    Maße  (L x B x H): 57 x 37 x 32 cm​<br>
                                    Max. Gewicht: 25 kg​<br>
                                    Geeignet für: T-Shirts, DVDs etc.​
                                </p>
                                <p class="card-text"><strong class="text-muted">@*Anlieferung und Abholung ab 0,00 €*@</strong></p>

                                <div class="btn-roomit-div mt-4">
                                    <a type="button" asp-controller="Shop" asp-action="Karton" asp-route-Zipcode="@Model.Postleitzahl" asp-route-Stadtname="@Model.Stadtname" class="btn btn-roomit abs btn-details" >Details</a>
                                </div>
                            </div>
                        </div>
                        <!--  Quantity && + und -   -->
                        <div class="col-md-3 Fliestext quantity">
                            <div class="quantity-1">
                                <span class="article-column-headline">Anzahl</span>
                                <br />
                                <span class="text">Mindestmenge: 3 Stück</span>
                            </div>                           
                            <div class="cont-add-prod btn-roomit-div">
                                 <button class="minus minus2 btn-roomit btn-center abs btn-shop" value="4" style="display:none;">-</button>
                                    <p class="product-counter">0</p>                              
                                <button class="plus plus2 btn-roomit btn-center abs btn-shop" value="4">+</button>
                            </div>
                        </div>
                        <!-- Preis  -->
                        <div class="col-md-3 ps-5 Fliestext preis">
                            <div class="preis-1">
                                <span class="article-column-headline">Preis</span>
                                <br />
                                <span class="text">Pro Monat zzgl. Lieferkosten</span>
                            </div>

                            <div class="preis-1">   
                                <div class="cont-add-prod text-center preis-2">   
                                    <span class="result fw-bold">0,00 €</span>                                                          
                                </div>
                                <div class="preis-3">
                                    <input type="button" class="btn mt-4 in-warenkorb btn-roomit btn-center abs" style="min-width:auto;font-weight:normal!important;"  value="In den Warenkorb" />
                                </div>
                            </div>
                         
                        </div>
                    </div>
                    <span class="price-info">ab <span class="price">4,00 €</span> pro Karton-Box</span>
                </div>

                <!-- Container Bolck -->
