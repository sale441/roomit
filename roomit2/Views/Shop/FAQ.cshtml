<style>
.accordionContainer{
    min-height:700px;
}

.accordion-body {
    min-height:100px;
    height:auto;
}

.accordion-item-body{
    font-size: 20px !important;
    min-height: 200px;
    height:auto;
    padding: 20px;
    unicode-bidi: isolate;     
    /*background: linear-gradient(0deg, transparent 25px, #f5f4f0 25px);*/
}

.accordion-button::after {
    flex-shrink: 0;
    width: var(--bs-accordion-btn-icon-width);
    height: 40px; /*var(--bs-accordion-btn-icon-width);*/
    margin-left: auto;
    content: "";
    background-image: none;
    background-repeat: no-repeat;
    background-size: var(--bs-accordion-btn-icon-width);
    transition: var(--bs-accordion-btn-icon-transition);
}

.accordion-item {
    position: relative;
    cursor: pointer;
    min-height: 90px;
    padding-left: 20px;
    padding-right: 32px;
    /*margin-bottom:8px;*/
    /*display: -webkit-box;
    /*display: -ms-flexbox;*/
    /*display: flex;*/
    align-items:center;
    -webkit-box-orient: horizontal;
    -webkit-box-direction: normal;
    /*-ms-flex-direction: row;*/
    flex-direction: row;
    /*background: #cce0ee;*/
    background-position: bottom right;
    background-repeat: no-repeat;
    text-transform: uppercase;
    line-height: 1.5rem;
    overflow: hidden;
      
}

.accordion-button{
    background: linear-gradient(315deg, transparent 25px, #6E6E6E 25px); /* HIer ist die Hintergrundfarbe Unausgeklappt */
    color: #FFFFFF;                                                    /* font-color im Balken selbst der Title */
    font-size: 20px;                                                     /* font-size im Balken selbst der Title */

}

.accordion-button:not(.collapsed)::after {
    background-image: none;
    transform: none;
}

 .accordion-button:not(.collapsed) {
  color: none!important;
  background-color: none!important;
  box-shadow: none!important;
  background: linear-gradient(315deg, transparent 25px, #6E6E6E 25px); /* HIer ist die Hintergrundfarbe Ausgeklappt */
  color: white; 
}

.accordion {
    --bs-accordion-border-color: none;
    --bs-accordion-active-bg: none;
    border:0;
    --bs-accordion-btn-focus-box-shadow: none;
}

.accordion-item:first-of-type .accordion-button {
    border-top-left-radius: none;
    border-top-right-radius: none;
}

.accordion-button:focus {
  z-index: 3;
  border-color: none;
  outline: 0;
  box-shadow: var(--bs-accordion-btn-focus-box-shadow);
}

.accordionContainer .plus {
    background: linear-gradient(315deg, transparent 25px, #8AA8CA63 25px);
    color: #4d4d4d;
}
   

.accordionContainer .minus {
    background: linear-gradient(315deg, transparent 25px, #00469B 25px);
    color: white;       
}

.noCollapse{
    display:block;
}

.okCollapse {
    display: none;
}

.accordion-item {
  cursor: pointer;
  text-transform: none;
  text-transform: none;
  line-height: 1.5rem;
  text-align: justify;
}

.title-size{
        font-size: 16px!important;
}

  
</style>

