            <div class="platzSchafenRaster">

                <h2 class="mt-2 mb-2 ueberschrift">Noch nie war Platz schaffen so einfach!</h2>

                <div class="mt-4 lineX"></div>

                <div class="text-center" style="margin-bottom:100px;">
                    <h4><strong>Du bestellst. Wir liefern. Hol dir jetzt den Platz du brauchst!</strong></h4>
                </div>

                <div class="mt-5 pictures row Fliestext">
                    <div class="card col-lg-3">
                        <div class="down-content kreis-nr">1</div>
                        <img src="assets/images/1.png" class="card-img-top" alt="img_roomit_Lebtop">
