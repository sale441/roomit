@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<script>
    //// friendlycaptchaToken Listener Onload the Tocken
    const captchaWidget = document.querySelector(".frc-captcha");
    const myButton = document.getElementById("registerSubmit");
    myButton.style.pointerEvents = 'none';
    myButton.classList.remove('btn-roomit');

    captchaWidget.addEventListener("frc:widget.complete", function (event) {
        document.getElementById('friendlycaptchaToken2').value = event.detail.response
        myButton.style.pointerEvents = 'auto';
        myButton.disabled = false;
        myButton.classList.add('btn-roomit');
    });

    captchaWidget.addEventListener("frc:widget.error", function (event) {
        myButton.style.pointerEvents = 'none';
        myButton.classList.remove('btn-roomit');
        myButton.disabled = true;
        document.getElementById('err').innerText = event.detail.error
    });

    captchaWidget.addEventListener("frc:widget.expired", function (event) {
        myButton.style.pointerEvents = 'none';
        myButton.classList.remove('btn-roomit');
        myButton.disabled = true;
        document.getElementById('#err').innerText('Das Anti Roboter Verifizierung ist abgelaufen, versuchen Sie nochmal!');
    });
</script>