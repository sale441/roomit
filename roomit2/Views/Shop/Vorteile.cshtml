@{
    ViewData["Title"] = "Vorteile der Einlagerung | room it!";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section metatags{
    <title>Vorteile der Einlagerung | room it!</title>
    <meta name="description" content="Entdecke die Vorteile einer Einlagerung bei uns ✅ Jetzt informieren!">
    <meta name="keywords" content="Vorteile, Sicherheit, überwachte Lager, Sicherheitslager, Wunschtermin">
}

<div>
    <div class="container Fliestext" style="max-width: 1620px;">
        <!-- ***** Section-2  Video ***** -->
        <div class="row">
            <div class="teil2 mt-5">

                @*<div class="aufheben-innen-1 mb-4">
                    <div class="mt-3">
                        <img class="" src="/assets/images/roomit_signet.png" alt="" width="240" height="100">
                    </div>
                </div>*@

                 <div class="pt-5">
                    <h6 class="mb-0 ueberschrift2" style="margin:0;text-align:start;margin-bottom: 20px;font-weight:normal;color:#FF6000;">
                       <a href="javascript:history.back()" style="color:#FF6000;text-decoration:none;">
                            zurück
                        </a>
                    </h6>
                </div>

                <div class="aufheben-innen-2">
                    <h1 class="mt-2 mb-2 ueberschrift"> Deine Vorteile mit room it!</h1>

                    <div class="mt-2 mb-5 lineX" style="width:40%;"></div>

                    <div style="margin-top:100px;">

                        <div class="card mb-4" style="background-color:#F3F3F3">
                            <div class="row g-0">
                                <div class="col-md-4" style="display: flex;justify-content: start;">
                                    <img src="/assets/images/roomit_sichere_lagerung.png" class="img-fluid rounded-start" alt="...">
                                </div>
                                <div class="col-md-8">
                                    <div class="card-body mt-4 p-5">
                                        <h2 class="card-title fw-bold">Sichere Lagerung in deiner Nähe</h2>
                                        <p class="card-text Fliestext">
                                            Deine Boxen sind bei uns in Sicherheit! Unsere Lager sind rund um die Uhr videoüberwacht und werden ausschließlich durch unser speziell geschultes
                                            Personal betreten.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card mb-4" style="background-color:#F3F3F3">
                            <div class="row g-0">
                                <div class="col-md-8">
                                    <div class="card-body mt-4 p-5">
                                        <h2 class="card-title fw-bold">Einfach & unkompliziert </h2>
                                        <p class="card-text Fliestext">
                                            Die Anlieferung/Abholung deiner Lagerbox ist schon ab 50,00 €
                                            möglich! Zu deinem Wunschtermin liefern wir dir die Boxen
                                            direkt vor die Haustür!

                                        </p>
                                    </div>
                                </div>
                                <div class="col-md-4" style="display: flex;justify-content: end;">
                                    <img src="/assets/images/roomit_anlieferung_XXL.png" alt="..." height="250">
                                </div>
                            </div>
                        </div>



                        <div class="card mb-4" style="background-color:#F3F3F3">
                            <div class="row g-0">
                                <div class="col-md-4" style="display: flex;justify-content: start;">
                                    <img src="/assets/images/roomit_abrechnung.png" class="img-fluid rounded-start" alt="...">
                                </div>
                                <div class="col-md-8">
                                    <div class="card-body mt-4 p-5">
                                        <h2 class="card-title fw-bold">Transparente Abrechnung</h2>
                                        <p class="card-text Fliestext">
                                            Bezahle bequem über eine der angebotenen Zahlungsarten.
                                            Die Abrechnung und Belastung erfolgt monatlich zum Stichtag.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card mb-4" style="background-color:#F3F3F3">
                            <div class="row g-0">
                                <div class="col-md-8">
                                    <div class="card-body mt-4 p-5">
                                        <h2 class="card-title fw-bold">Einzelrücklieferung möglich</h2>
                                        <p class="card-text Fliestext">
                                            Du möchtest nicht alle Boxen, sondern nur eine oder einen Teil der Boxen
                                            zurückgeliefert bekommen? Kein Problem!
                                        </p>
                                    </div>
                                </div>
                                <div class="col-md-4" style="display: flex;justify-content: end;">
                                    <img src="/assets/images/roomit_einzelruecklieferung.png" alt="..." height="250">
                                </div>
                            </div>
                        </div>

                    </div>


                </div>
            </div>
        </div>

    </div>


    <div class="container rasterfooter-0 mt-4 mb-5 Fliestext">
        <div class="rasterfooter Fliestext" style="max-width:1260px;">
            <div class="col-7">
                <p style="font-size:30px!important;color:white;font-weight:bold;">
                    <span>Hast du noch eine Frage?</span><br /><br />
                    <span class="fw-bolder" style="font-size:larger;">08131 2792920</span><br />
                    <span style="font-size:large;">Mo.- Fr.: 09:00 - 17:00 Uhr</span><br />
                </p>
            </div>

            <div class="col-5 sos-2">
                <button onclick="location.href='/Kontakt'" class="btn btn-roomit"><p style="margin-bottom:0;margin-top:0;">Kontaktformular</p></button>
                <button onclick="location.href='/FAQ'" class="btn btn-roomit"><p style="margin-bottom:0;margin-top:0;">FAQ</p></button>
            </div>

        </div>
    </div>
</div>






