<div class="container">

    <div class="container-fliud">
        <div class="pt-5">
            <h6 class="mb-0 ueberschrift" style="margin:0;text-align:start;margin-bottom: 20px;font-weight:normal;color:#FF6000;">
                @*<a href="@Url.Action("Shop", "Shop",new{zipcode = @Model.Postleitzahl})" style="color:#FF6000;;">
                <!--<i class="fas fa-long-arrow-alt-left me-2"></i> --> zurück
